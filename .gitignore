# =============================================================================
# SMART-PARK ENTERPRISE - .gitignore
# =============================================================================

# --- Node & Frontend Dependencies ---
node_modules/
frontend/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Frontend Builds & Caches ---
frontend/dist/
frontend/dist-ssr/
*.local
dist/
build/
.eslintcache
*.tsbuildinfo

# --- Testing & E2E Artifacts (Playwright, Jest, Pytest) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/e2e/videos/
frontend/e2e/screenshots/
*.webm

# --- Computer Vision & Machine Learning Weights ---
*.pt
*.pth
*.onnx
*.weights
*.bin
*.safetensors
backend/*.pt
backend/*.onnx
backend/models/
yolov8*.pt

# --- Python & Backend Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Databases, Storage & Local State ---
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite

# --- Environment & Secret Keys ---
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# --- Operating Systems & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp

# --- IDEs & Tools ---
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# --- Deployment Platforms & Caches ---
.serverless/
.npm-cache/
.turbo/
.next/

# --- Agente IA / Tooling local (no es parte del sistema) ---
.agents/
.agents/*
skills-lock.json

*.log
