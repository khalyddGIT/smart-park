# Smart Park — variables de entorno (SOLO PostgreSQL)
# Copia a .env en local. En Railway define las mismas en el dashboard.

# --- Obligatorias ---
ENVIRONMENT=development
SECRET_KEY=cambia-esto-en-produccion
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5434/smartpark_db

# --- Postgres por partes (fallback si no hay DATABASE_URL, sigue siendo Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartpark_db

# --- Archivos subidos ---
# Local/docker: ./uploads o /app/uploads (volumen backend_uploads)
# Railway: /data/uploads (monta un Volume en /data, el filesystem sin volumen se borra en cada deploy)
UPLOADS_DIR=./uploads

# --- Producción (Railway) ---
# ENVIRONMENT=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}  (plugin Postgres de Railway)
# CORS_ORIGINS=https://tu-frontend.up.railway.app
# SUPERADMIN_PASSWORD=...
# SUPERADMIN_PIN=...

# --- Opcionales ---
REDIS_URL=
RABBITMQ_URL=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
